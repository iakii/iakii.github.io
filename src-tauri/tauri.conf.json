{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "print-js",
  "version": "0.1.0",
  "identifier": "com.iakii.app.toolbox",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "小小工具箱",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
